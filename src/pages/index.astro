<script is:inline>
  (function() {
    let popupTimer;

    function initSakePopup() {
      const popup = document.getElementById('sakePopup');
      const closeBtn = document.getElementById('sakeClose');
      if (!popup) return;

      function closePopup() {
        popup.classList.add('hidden');
        if (popupTimer) clearTimeout(popupTimer);
      }

      closeBtn?.addEventListener('click', closePopup);
      popup.addEventListener('click', function(e) {
        if (e.target === popup) closePopup();
      });

      if (popupTimer) clearTimeout(popupTimer);
      popupTimer = setTimeout(closePopup, 10000);
    }

    document.addEventListener('DOMContentLoaded', initSakePopup);
    document.addEventListener('astro:page-load', initSakePopup);
  })();
</script>
</Layout>

<style>
  html, body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }

  .topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 60;
    background: rgba(0,0,0,0.78);
    backdrop-filter: blur(8px);
  }

  .app-shell {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    padding-top: calc(130px + env(safe-area-inset-top));
    padding-bottom: calc(56px + env(safe-area-inset-bottom));
  }
  @media (min-width: 640px) { .app-shell { padding-top: calc(158px + env(safe-area-inset-top)); } }
  @media (min-width: 768px) { .app-shell { padding-top: calc(178px + env(safe-area-inset-top)); } }

  /* Switch vistas */
  .view-desktop { display: none; }
  .view-mobile  { display: block; }

  @media (min-width: 1024px) {
    html, body { touch-action: auto; }
    .view-mobile  { display: none; }
    .view-desktop { display: block; }
    .app-shell {
      padding-top: calc(168px + env(safe-area-inset-top));
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }
  }

  /* ======================================================
     MÓVIL
  ====================================================== */
  .view-mobile {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .center-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
  }
  .hub {
    position: relative;
    width:  clamp(300px, 96vw, 560px);
    height: clamp(300px, 96vw, 560px);
    overflow: visible;
  }
  .hub-center {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 30; pointer-events: none;
  }
  .rosco {
    --n: 11; --rot: 0deg; --r: clamp(128px, 40vw, 222px);
    position: absolute; inset: 0;
    transform: rotate(var(--rot));
    touch-action: none; cursor: grab; z-index: 20;
  }
  .rosco:active { cursor: grabbing; }
  .dot {
    position: absolute; left: 50%; top: 50%;
    transform:
      translate(-50%,-50%)
      rotate(calc((360deg / var(--n)) * var(--i)))
      translate(var(--r))
      rotate(calc((-360deg / var(--n)) * var(--i) - var(--rot)));
    display: flex; flex-direction: column; align-items: center;
    gap: 5px; text-decoration: none; user-select: none;
  }
  .circle {
    width: clamp(52px,13vw,72px); height: clamp(52px,13vw,72px);
    border-radius: 999px; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.62); border: 1px solid rgba(255,255,255,0.2);
    color: #fff; font-size: clamp(20px,5vw,30px);
    box-shadow: 0 0 22px rgba(220,38,38,0.08); flex-shrink: 0;
  }
  .circle img { width: clamp(28px,7vw,42px); height: clamp(28px,7vw,42px); object-fit: contain; }
  .label {
    width: clamp(80px,20vw,106px); font-size: clamp(14px,4vw,17px);
    text-align: center; line-height: 1.2;
    color: rgba(255,255,255,0.92); text-shadow: 0 1px 8px rgba(0,0,0,0.7); font-weight: 600;
  }
  .dot:hover .circle { border-color: #dc2626; background: rgba(220,38,38,0.18); }

  @media (max-width: 380px) {
    .hub { width: 98vw; height: 98vw; }
    .rosco { --r: clamp(118px,38vw,148px); }
    .label { font-size: 13px; width: 70px; }
  }
  @media (min-width: 481px) and (max-width: 767px) {
    .hub { width: clamp(440px,88vw,560px); height: clamp(440px,88vw,560px); }
    .rosco { --r: clamp(175px,36vw,220px); }
    .circle { width: 68px; height: 68px; font-size: 28px; }
    .label { font-size: 17px; width: 96px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hub { width: clamp(500px,70vw,640px); height: clamp(500px,70vw,640px); }
    .rosco { --r: clamp(200px,28vw,250px); }
    .circle { width: 72px; height: 72px; font-size: 30px; }
    .label { font-size: 18px; width: 104px; }
  }
  @media (max-width: 1023px) { .hub { transform: none; } }

  /* ======================================================
     POPUP POSTRES
  ====================================================== */
 /* ======================================================
   POPUP POSTRES
====================================================== */
.sake-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  transition: opacity 250ms ease;
}

.sake-overlay.hidden {
  opacity: 0;
  pointer-events: none;
}

.sake-popup {
  position: relative;
  width: min(100%, 310px);
  max-height: min(88vh, 600px);
  background: #0d0008;
  border: 1px solid rgba(220,38,38,0.4);
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24px 60px rgba(0,0,0,0.8);
  animation: sakeIn 300ms cubic-bezier(0.34,1.56,0.64,1);
}

@keyframes sakeIn {
  from { transform: scale(0.88); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

.sake-blur-bg {
  position: absolute;
  inset: 0;
  background: url('/images/comida/platos/postres/pantera.png') center/cover no-repeat;
  filter: blur(18px) brightness(0.28) saturate(1.25);
  transform: scale(1.1);
  z-index: 0;
}

.sake-popup > *:not(.sake-blur-bg) {
  position: relative;
  z-index: 1;
}

/* BOTÓN CERRAR — arriba sin pisar contenido */
.sake-close {
  align-self: flex-end;
  margin: 9px 9px 0 0;
  padding: 9px 14px;
  border-radius: 10px;
  background: #dc2626;
  border: 2px solid #fff;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 5px 15px rgba(0,0,0,0.5);
}

.sake-close:hover,
.sake-close:focus-visible {
  background: #ef4444;
  transform: scale(1.03);
  outline: none;
}

/* TEXTO */
.sake-top {
  padding: 4px 16px 5px;
  text-align: center;
  width: 100%;
}

.sake-title {
  font-family: 'Burford', 'Bebas Neue', sans-serif;
  font-size: 1.55rem;
  line-height: 1.05;
  color: #fff;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0;
}

.sake-copy {
  max-width: 250px;
  margin: 8px auto 0;
  color: rgba(255,255,255,0.78);
  font-size: 12px;
  line-height: 1.4;
}

/* IMAGEN */
.sake-img {
  width: 72%;
  max-width: 215px;
  object-fit: contain;
  display: block;
  padding: 9px 0 12px;
  filter: drop-shadow(0 4px 20px rgba(245,208,96,0.28));
}

/* CTA */
.sake-cta-btn {
  display: block;
  width: calc(100% - 32px);
  margin: 0 16px 14px;
  padding: 11px 10px;
  text-align: center;
  text-decoration: none;
  background: rgba(220,38,38,0.18);
  border: 1px solid rgba(220,38,38,0.65);
  border-radius: 10px;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: background 150ms;
}

.sake-cta-btn:hover {
  background: rgba(220,38,38,0.32);
}

/* MÓVILES PEQUEÑOS */
@media (max-width: 380px), (max-height: 680px) {
  .sake-overlay {
    padding: 12px;
  }

  .sake-popup {
    width: min(100%, 286px);
    max-height: 94vh;
    border-radius: 16px;
  }

  .sake-close {
    margin: 7px 7px 0 0;
    padding: 8px 12px;
    font-size: 11px;
  }

  .sake-top {
    padding: 2px 12px 3px;
  }

  .sake-title {
    font-size: 1.3rem;
  }

  .sake-copy {
    font-size: 11px;
    max-width: 220px;
    margin-top: 6px;
  }

  .sake-img {
    width: 64%;
    max-width: 175px;
    padding: 6px 0 8px;
  }

  .sake-cta-btn {
    width: calc(100% - 28px);
    margin: 0 14px 12px;
    padding: 9px;
    font-size: 13px;
  }
}

  /* ======================================================
     BANNER INFERIOR POSTRES
  ====================================================== */
  .sake-strip-wrap {
    flex-shrink: 0;
    padding: 0 14px calc(10px + env(safe-area-inset-bottom));
  }
  .sake-strip {
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; padding: 12px 16px; border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(220,38,38,0.3);
    text-decoration: none;
    transition: border-color 180ms, transform 180ms;
  }
  .sake-strip:active { transform: scale(0.98); }
  .sake-strip:hover  { border-color: rgba(220,38,38,0.6); }

  .sake-strip-bg {
    position: absolute; inset: 0;
    background: url('/images/comida/platos/postres/pantera.png') center/cover no-repeat;
    filter: blur(6px) brightness(0.25) saturate(1.3);
    transform: scale(1.08);
  }

  .sake-strip-text {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; gap: 2px;
  }
  .sake-strip-eyebrow {
    font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(220,38,38,0.75);
  }
  .sake-strip-name {
    font-family: 'Burford', 'Bebas Neue', sans-serif;
    font-size: 1.2rem; color: #fff; letter-spacing: 0.06em; line-height: 1;
  }

  .sake-strip-more {
    position: relative; z-index: 1;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(255,255,255,0.6); flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.15);
    padding: 4px 10px; border-radius: 20px;
  }

  /* Banner móvil */
  .mob-banner-wrap {
    flex-shrink: 0;
    padding: 0 16px calc(14px + env(safe-area-inset-bottom));
  }
  .mob-banner {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: 14px;
    background: linear-gradient(120deg,#1a0830 0%,#2e0a0a 55%,#1a0830 100%);
    border: 1px solid rgba(200,160,40,0.35);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .mob-banner:hover { border-color: rgba(245,208,96,0.65); transform: translateY(-2px); }
  .mob-candles { display: flex; align-items: flex-end; gap: 4px; flex-shrink: 0; }
  .mob-candles span { display: block; width: 3px; border-radius: 2px 2px 0 0; background: linear-gradient(to top,#b07808,#f5d060); }
  .mob-candles span::after { content:""; display:block; width:7px; height:2px; background:#b07808; border-radius:1px; margin-left:-2px; }
  .mob-text { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
  .mob-new  { font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(220,180,80,0.7); }
  .mob-name { font-family: var(--font-burford,serif); font-size: 18px; font-weight: 700; color: #f5d060; letter-spacing: 0.04em; line-height: 1; text-transform: uppercase; }
  .mob-sub  { font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(220,200,150,0.6); margin-top: 2px; }
  .mob-cta  { font-size: 12px; font-weight: 600; color: rgba(245,208,96,0.85); flex-shrink: 0; padding-left: 8px; }

  /* ======================================================
     SOCIALS (compartido)
  ====================================================== */
  .socials { display: flex; align-items: center; gap: 12px; }
  .social-btn {
    width: 42px; height: 42px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.92); transition: all 180ms ease;
  }
  .social-btn:hover { border-color: rgba(220,38,38,0.65); background: rgba(220,38,38,0.14); }
  .social-btn :global(svg) { width: 18px; height: 18px; }
  .social-btn img { width: 18px; height: 18px; object-fit: contain; }

  /* ======================================================
     DESKTOP
  ====================================================== */
  .view-desktop { position: relative; height: 100%; width: 100%; }

  /* Rosco centrado */
  .desk-right {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
  }

  /*
    Panel izquierdo: columna flex de arriba a abajo.
    .desk-banner crece (flex:1) y rellena el hueco.
    .cta-card es flex-shrink:0 y siempre se ve abajo.
  */
  .desk-left {
    position: absolute;
    left: 32px; top: 24px; bottom: 24px;
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 4;
  }

  /* Banner desktop — vertical, rellena el espacio libre */
  .desk-banner {
    flex: 1;
    min-height: 0;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 20px;
    border-radius: 14px;
    background: linear-gradient(160deg,#1a0830 0%,#2e0a0a 55%,#1a0830 100%);
    border: 1px solid rgba(200,160,40,0.35);
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .desk-banner:hover { border-color: rgba(245,208,96,0.65); transform: translateY(-2px); }

  .desk-candles { display: flex; align-items: flex-end; gap: 5px; }
  .desk-candles span { display: block; width: 3px; border-radius: 2px 2px 0 0; background: linear-gradient(to top,#b07808,#f5d060); }
  .desk-candles span::after { content:""; display:block; width:8px; height:2px; background:#b07808; border-radius:1px; margin-left:-2.5px; }

