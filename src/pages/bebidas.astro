---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bebidas - Lucky Luke" showMarquee={false}>
  <link slot="head" rel="preload" as="image" href="/images/logos/lona superior.webp" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/images/logos/Lucky_Simple_principal.webp" fetchpriority="high" />

  <header class="topbar">
    <a href="/" class="topbar-inicio" aria-label="Inicio">
      <span class="topbar-inicio-arrow">←</span>
      <span class="topbar-inicio-label">Inicio</span>
    </a>
    <div class="container mx-auto px-4 py-3 flex justify-center items-center">
      <img src="/images/logos/lona superior.webp" alt="Lucky Luke Logo" class="h-24 sm:h-32 md:h-36" fetchpriority="high" loading="eager" />
    </div>
  </header>

  <main class="app-shell">

    <!-- ========================= MÓVIL ========================= -->
    <div class="view-mobile">
      <section class="center-stage">
        <div class="hub">
          <div class="hub-center pointer-events-none">
            <img src="/images/logos/Lucky_Simple_principal.webp" alt="Lucky Luke"
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border border-white/25 bg-black shadow-[0_0_60px_rgba(220,38,38,0.12)]" />
          </div>
          <nav id="bebidasRoscoMobile" class="rosco">
            <a class="dot" style="--i:0.25" href="/bebidas/cerveza"><span class="circle">🍺</span><span class="label">Cerveza</span></a>
            <a class="dot" style="--i:1.25" href="/bebidas/refrescos"><span class="circle">🥤</span><span class="label">Refrescos</span></a>
            
          </nav>
        </div>
      </section>

    </div>

    <!-- ========================= DESKTOP ========================= -->
    <div class="view-desktop">
      <aside class="desk-left">
        <div class="cta-card">
          <p class="cta-title font-burford">SÍGUENOS EN NUESTRAS REDES</p>
          <div class="socials">
            <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-btn">
              <i data-feather="instagram"></i>
            </a>
            <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-btn">
              <i data-feather="facebook"></i>
            </a>
            <a href="#" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-btn">
              <i data-feather="instagram"></i>
            </a>
          </div>
          <div class="cta-hint text-white/55 text-sm">Arrastra el rosco para explorar las bebidas.</div>
        </div>
      </aside>

      <div class="desk-right">
        <div class="hub hub-desktop">
          <div class="hub-center pointer-events-none">
            <img src="/images/logos/Lucky_Simple_principal.webp" alt="Lucky Luke"
              class="rounded-full border border-white/25 bg-black shadow-[0_0_60px_rgba(220,38,38,0.12)]"
              style="width:clamp(80px,7vw,120px);height:clamp(80px,7vw,120px)" />
          </div>
          <nav id="bebidasRoscoDesktop" class="rosco rosco-desktop">
             <a class="dot" style="--i:0.25" href="/bebidas/cerveza"><span class="circle">🍺</span><span class="label">Cerveza</span></a>
            <a class="dot" style="--i:1.25" href="/bebidas/refrescos"><span class="circle">🥤</span><span class="label">Refrescos</span></a>
            
          </nav>
        </div>
      </div>
    </div>

  </main>
</Layout>

<style>
  html, body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }

  .topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 60;
    background: rgba(0,0,0,0.78);
    backdrop-filter: blur(8px);
  }

  .topbar-inicio {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    padding: 0 14px;
    text-decoration: none;
    border-right: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.72);
    transition: color 0.2s, background 0.2s;
    z-index: 10;
  }
  .topbar-inicio:hover {
    background: rgba(220,38,38,0.1);
    color: #fff;
  }
  .topbar-inicio-arrow { font-size: 15px; line-height: 1; }
  .topbar-inicio-label { font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; }

  .app-shell {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    padding-top: calc(130px + env(safe-area-inset-top));
    padding-bottom: calc(56px + env(safe-area-inset-bottom));
  }
  @media (min-width: 640px) { .app-shell { padding-top: calc(158px + env(safe-area-inset-top)); } }
  @media (min-width: 768px) { .app-shell { padding-top: calc(178px + env(safe-area-inset-top)); } }

  .view-desktop { display: none; }
  .view-mobile  { display: block; }

  @media (min-width: 1024px) {
    html, body { touch-action: auto; }
    .view-mobile  { display: none; }
    .view-desktop { display: block; }
    .app-shell {
      padding-top: calc(168px + env(safe-area-inset-top));
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }
  }

  /* MÓVIL */
  .view-mobile {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .center-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
  }
  .hub {
    position: relative;
    width:  clamp(300px, 96vw, 560px);
    height: clamp(300px, 96vw, 560px);
    overflow: visible;
  }
  .hub-center {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 30; pointer-events: none;
  }
  .rosco {
    --n: 2; --rot: 0deg; --r: clamp(128px, 40vw, 200px);
    position: absolute; inset: 0;
    transform: rotate(var(--rot));
    touch-action: none; cursor: grab; z-index: 20;
  }
  .rosco:active { cursor: grabbing; }
  .dot {
    position: absolute; left: 50%; top: 50%;
    transform:
      translate(-50%,-50%)
      rotate(calc((360deg / var(--n)) * var(--i)))
      translate(var(--r))
      rotate(calc((-360deg / var(--n)) * var(--i) - var(--rot)));
    display: flex; flex-direction: column; align-items: center;
    gap: 5px; text-decoration: none; user-select: none;
  }
  .circle {
    width: clamp(72px,18vw,96px); height: clamp(72px,18vw,96px);
    border-radius: 999px; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.62); border: 1px solid rgba(255,255,255,0.2);
    color: #fff; font-size: clamp(30px,8vw,44px);
    box-shadow: 0 0 22px rgba(220,38,38,0.08); flex-shrink: 0;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .label {
    width: clamp(82px,21vw,110px); font-size: clamp(14px,4vw,17px);
    text-align: center; line-height: 1.2;
    color: rgba(255,255,255,0.92); text-shadow: 0 1px 8px rgba(0,0,0,0.7); font-weight: 600;
  }
  .dot:hover .circle { border-color: #dc2626; background: rgba(220,38,38,0.18); box-shadow: 0 0 18px rgba(220,38,38,0.45); }

  @media (max-width: 380px) {
    .hub { width: 98vw; height: 98vw; }
    .rosco { --r: clamp(110px,36vw,148px); }
    .label { font-size: 13px; width: 72px; }
  }
  @media (min-width: 481px) and (max-width: 767px) {
    .hub { width: clamp(440px,88vw,560px); height: clamp(440px,88vw,560px); }
    .rosco { --r: clamp(170px,35vw,220px); }
    .circle { width: 70px; height: 70px; font-size: 30px; }
    .label { font-size: 17px; width: 98px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hub { width: clamp(500px,70vw,640px); height: clamp(500px,70vw,640px); }
    .rosco { --r: clamp(200px,28vw,250px); }
    .circle { width: 74px; height: 74px; font-size: 32px; }
    .label { font-size: 18px; width: 106px; }
  }
  @media (max-width: 1023px) { .hub { transform: none; } }

  /* SOCIALS */
  .socials { display: flex; align-items: center; gap: 12px; }
  .social-btn {
    width: 42px; height: 42px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.92); transition: all 180ms ease;
  }
  .social-btn:hover { border-color: rgba(220,38,38,0.65); background: rgba(220,38,38,0.14); }
  .social-btn :global(svg) { width: 18px; height: 18px; }

  /* DESKTOP */
  .view-desktop { position: relative; height: 100%; width: 100%; }

  .desk-left {
    position: absolute;
    left: 32px; top: 24px; bottom: 24px;
    width: 300px;
    display: flex; flex-direction: column; gap: 12px;
    z-index: 4;
  }
  .desk-right {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
  }
  .cta-card {
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(10px);
    border-radius: 14px;
    padding: 14px 16px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .cta-title { font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; color: rgba(255,255,255,0.38); }

  .hub-desktop {
    --avail: calc(100vh - 220px);
    width:  min(clamp(460px,46vw,700px), var(--avail));
    height: min(clamp(460px,46vw,700px), var(--avail));
  }
  .rosco-desktop { --r: min(clamp(185px,18vw,270px), calc((100vh - 220px) * 0.39)); }
  .hub-desktop .circle { width: clamp(82px,7vw,108px); height: clamp(82px,7vw,108px); font-size: clamp(34px,3.6vw,48px); }
  .hub-desktop .label { font-size: clamp(15px,1.3vw,19px); width: clamp(96px,9vw,120px); }

  @media (min-width: 1440px) {
    .hub-desktop   { width: min(780px,calc(100vh - 220px)); height: min(780px,calc(100vh - 220px)); }
    .rosco-desktop { --r: min(305px,calc((100vh - 220px) * 0.39)); }
  }
</style>

<script is:inline>
  function setupBebidasRosco(roscoId, initRot) {
    const rosco = document.getElementById(roscoId);
    if (!rosco) return;

    let isDown = false, startAngle = 0, baseRot = 0, currentRot = initRot || -90;
    let auto = true;
    const AUTO_SPEED = 0.07;
    let rafId;

    function center() {
      const r = rosco.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    }
    function angle(x, y) {
      const c = center();
      return Math.atan2(y - c.y, x - c.x) * 180 / Math.PI;
    }
    function setRot(deg) {
      currentRot = deg;
      rosco.style.setProperty('--rot', deg + 'deg');
    }
    function autoLoop() {
      if (!auto) return;
      setRot(currentRot + AUTO_SPEED);
      rafId = requestAnimationFrame(autoLoop);
    }
    function down(x, y) {
      if (auto) { auto = false; cancelAnimationFrame(rafId); }
      isDown = true; startAngle = angle(x, y); baseRot = currentRot;
    }
    function move(x, y) { if (!isDown) return; setRot(baseRot + (angle(x, y) - startAngle)); }
    function up() { isDown = false; }

    rosco.addEventListener('mousedown', e => down(e.clientX, e.clientY));
    window.addEventListener('mousemove', e => move(e.clientX, e.clientY));
    window.addEventListener('mouseup', up);
    rosco.addEventListener('touchstart', e => { const t = e.touches[0]; down(t.clientX, t.clientY); }, { passive: true });
    rosco.addEventListener('touchmove',  e => { const t = e.touches[0]; move(t.clientX, t.clientY); }, { passive: true });
    rosco.addEventListener('touchend', up);
    rosco.addEventListener('touchcancel', up);

    setRot(currentRot);
    autoLoop();
  }

  function initBebidas() {
    if (window.feather) window.feather.replace();
    setupBebidasRosco('bebidasRoscoMobile', -90);
    setupBebidasRosco('bebidasRoscoDesktop', -90);
  }

  document.addEventListener('DOMContentLoaded', initBebidas);
  document.addEventListener('astro:page-load', initBebidas);
</script>
