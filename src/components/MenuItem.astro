---
// Menu Item Component
interface Props {
  name: string;
  price: string;
  description: string;
  allergens?: string[];
}
const { name, price, description, allergens = [] } = Astro.props;

const allergenColors: Record<string, string> = {
  'Gluten': 'bg-red-700',
  'Huevo': 'bg-yellow-700',
  'Lácteos': 'bg-green-600',
  'Soja': 'bg-blue-600',
  'Sésamo': 'bg-stone-700',
  'Sulfitos': 'bg-gray-600',
  'Mostaza': 'bg-amber-600',
  'Apio': 'bg-lime-700',
  'Cacahuetes': 'bg-orange-700',
  'Frutos secos': 'bg-orange-600',
};
---

<details class="group border-western bg-black/40 hover:bg-gray-900 transition duration-300 p-5 md:p-6 min-h-[120px] col-span-full">
  <summary class="cursor-pointer list-none">
    <div class="flex justify-between items-start mb-3 gap-4">
      <h3 class="font-burford text-xl md:text-2xl text-red-600 leading-tight">{name}</h3>
      <span class="font-burford text-lg md:text-xl whitespace-nowrap">{price}</span>
    </div>

    <p class="font-bratton text-sm md:text-base text-gray-300 leading-relaxed">{description}</p>

    {allergens.length > 0 && (
      <p class="mt-3 font-bratton text-xs text-gray-400 group-open:hidden">
        Toca para ver alérgenos
      </p>
    )}
  </summary>

  {allergens.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {allergens.map(allergen => (
        <span class={`${allergenColors[allergen] || 'bg-gray-600'} text-white text-xs px-3 py-1.5 rounded`}>
          {allergen}
        </span>
      ))}
    </div>
  )}
</details>

<style>
  /* quita el triángulo nativo del summary */
  summary::-webkit-details-marker { display: none; }
</style>
